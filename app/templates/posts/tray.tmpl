{{ define "posts/tray.tmpl" }}
<!DOCTYPE html>
<html>
<head>
    <meta charset='utf-8' />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <title>DocTray</title>
    <link href='/resources/css/main.css' rel='stylesheet' type='text/css' />
	<!-- TODO: self-host material symbols, drop google service -->
	<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script src="/resources/scripts/dragondrop.js"></script>
</head>
<body class="tray-page">
<div id="page-container">
    {{ template "base/header.tmpl" }}
    <div id="tray-container">
        {{ template "posts/workspace-container.tmpl" . }}
        {{ template "base/composer.tmpl" . }}
    </div>
    {{ template "base/tray-navigation.tmpl" }}
    {{ template "base/footer.tmpl" }}
{{ end }}


{{ define "posts/workspace-container.tmpl" }}
    <div id="workspace-container">
    {{ template "base/tags.tmpl" . }}
    {{ template "base/doc-list.tmpl" . }}
    <button id="doc-jump-bottom" type="button" aria-label="Jump to latest message" aria-controls="doc-container" title="Jump to latest message" hidden><span class="material-symbols-outlined" aria-hidden="true">keyboard_arrow_down</span></button>
    </div>
{{ end }}
