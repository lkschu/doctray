{{ define "base/tags.tmpl" }}
<div id="tag-container" data-tag-mode="{{ if .Tag_edit }}edit{{ else }}filter{{ end }}">
    <link href='/resources/css/tags.css' rel='stylesheet' type='text/css' />

    {{ if .Tag_edit }}
        {{ template "base/tags-edit.tmpl" . }}
    {{ else }}
        {{ template "base/tags-show.tmpl" . }}
    {{ end  }}
</div>
{{ end }}

{{ define "base/tags-show.tmpl" }}
    <div class="tag-filter-panel" role="group" aria-label="Message filters">
        {{ if .Tags }}
        <ul id="tag-filter-list" aria-label="Filter by tag">
            {{ range $tag := .Tags }}
                {{ template "base/tagshow.tmpl" $tag }}
            {{ end }}
        </ul>
        {{ end }}
        <div class="tag-filter-toolbar">
            <button class="tag-star-filter" id="star-filter-button" type="button" aria-pressed="{{ if .Only_favorites }}true{{ else }}false{{ end }}"
                hx-post="/tray/star-filter" hx-sync="#tray-container:drop"
                hx-target="#workspace-container" hx-swap="outerHTML scroll:#doc-container:bottom">
                <span class="tag-star-icon" aria-hidden="true">★</span>
                <span>Starred only</span>
                <span class="tag-filter-selection" aria-hidden="true">✓</span>
            </button>
            {{ if .HasActiveFilters }}
            <button class="tag-manage-button" id="clear-filters-button" type="button"
                hx-post="/tray/filters-clear" hx-sync="#tray-container:drop"
                hx-target="#workspace-container" hx-swap="outerHTML scroll:#doc-container:bottom">Clear filters</button>
            {{ end }}
            <button class="tag-manage-button" id="tags-edit-button" type="button"
                hx-post="/tray/tag-edit" hx-sync="#tray-container:drop" hx-target="#tag-container" hx-swap="outerHTML">Manage tags</button>
        </div>
    </div>
{{ end }}

{{ define "base/tagshow.tmpl" }}
    <li id="tag-li-{{ .Nr }}">
        <button class="tag-filter-chip" id="select-tag-{{ .Nr }}" type="button" title="{{ .DisplayName }}"
            style="--tag-color: {{ if .Color }}{{ .Color }}{{ else }}#777777{{ end }}"
            aria-pressed="{{ if .Enabled }}true{{ else }}false{{ end }}"
            hx-post="/tray/tag-toggle-filter" hx-vals='{"id":"{{ .ID }}"}'
            hx-sync="#tray-container:drop" hx-target="#workspace-container" hx-swap="outerHTML scroll:#doc-container:bottom">
            {{ if .Sym }}<span class="tag-filter-symbol" aria-hidden="true">{{ .Sym }}</span>{{ end }}
            <span class="tag-filter-name">{{ .DisplayName }}</span>
            <span class="tag-filter-selection" aria-hidden="true">✓</span>
        </button>
    </li>
{{ end }}

{{ define "base/tags-edit.tmpl" }}
    <form id="tag-editor-form" hx-post="/tray/tag-apply" hx-encoding="multipart/form-data"
        hx-sync="#tray-container:drop" hx-target="#workspace-container" hx-swap="outerHTML scroll:#doc-container:bottom"
        hx-disabled-elt="#tag-editor-form button, #tag-editor-form input">
        <div class="tag-editor-toolbar">
            <h2>Manage tags</h2>
            <div class="tag-editor-actions">
                <button class="tag-manage-button" id="tag-add-button" type="button"
                    hx-post="/tray/tag-create" hx-sync="#tray-container:drop" hx-target="#tag-container" hx-swap="outerHTML">Add tag</button>
                <button class="tag-manage-button tag-editor-save" id="tag-save-button" type="submit">Save changes</button>
                <button class="tag-manage-button" id="tag-cancel-button" type="button"
                    hx-post="/tray/tag-cancel" hx-params="none" hx-sync="#tray-container:drop" hx-target="#tag-container" hx-swap="outerHTML">Cancel</button>
            </div>
        </div>
        {{ if .Tags }}
        <div class="tag-editor-columns" aria-hidden="true"><span>Emoji</span><span>Name</span><span>Colour</span><span></span></div>
        {{ else }}
        <p class="tag-editor-empty">No tags yet. Add one to get started.</p>
        {{ end }}
        <ul id="tag-editor-list" aria-label="Editable tags">
            {{ range $tag := .Tags }}
                {{ template "base/tagedit.tmpl" $tag }}
            {{ end }}
        </ul>
    </form>
{{ end }}

{{ define "base/tagedit.tmpl" }}
    <li class="tag-editor-row" id="tag-li-{{ .Nr }}">
        <input type="hidden" name="tag[{{ .Nr }}]tag_id" value="{{ .ID }}">
        <label class="tag-editor-field" for="tag-symbol-{{ .Nr }}">
            <span class="tag-editor-label">Emoji</span>
            <input type="text" class="tag-editor-symbol" id="tag-symbol-{{ .Nr }}" name="tag[{{ .Nr }}]symbol"
                value="{{ .Sym }}" aria-label="Emoji for {{ .DisplayName }}">
        </label>
        <label class="tag-editor-field" for="tag-name-{{ .Nr }}">
            <span class="tag-editor-label">Name</span>
            <input type="text" id="tag-name-{{ .Nr }}" name="tag[{{ .Nr }}]name"
                value="{{ .Name }}" placeholder="Tag name" aria-label="Name for {{ .DisplayName }}">
        </label>
        <label class="tag-editor-field" for="tag-color-{{ .Nr }}">
            <span class="tag-editor-label">Colour</span>
            <input type="color" id="tag-color-{{ .Nr }}" name="tag[{{ .Nr }}]color"
                value="{{ if .Color }}{{ .Color }}{{ else }}#777777{{ end }}" aria-label="Colour for {{ .DisplayName }}">
        </label>
        <button class="tag-editor-remove" type="button" aria-label="Remove {{ .DisplayName }}" title="Remove tag">×</button>
    </li>
{{ end }}
