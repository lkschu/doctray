{{ define "base/doc.tmpl" }}
    <div class="doc-entry-container" id="doc-entry-container-{{.DocID}}">
        {{ template "base/doc-entry.tmpl" . }}
    </div>
{{ end }}

{{ define "base/doc-entry.tmpl" }}
    {{ if .DeletedAt }}
        {{ template "base/doc-removed.tmpl" . }}
    {{ else }}
        <li class="doc-entry doc-type-{{.Type}}">
            <div class="doc-entry-inlist debug">

                <div class="doc-entry-content debug">
                    <div class="doc-entry-tagview debug">
                        {{ range $tagenabled := .Tags_enabled }}
                            {{ template "base/doc-tagbar-segments.tmpl" $tagenabled }}
                        {{ end }}
                    </div>

                    {{ if .Webpreview }}{{ template "base/doc-webpreviews.tmpl" . }}{{ end }}

                    <div class="doc-entry-type-container debug">
                        <!--<div style="white-space:pre-line">.Title</div>-->
                        {{.Title}}
					</div>

					{{ if .Files }}{{ template "base/doc-url.tmpl" .Files }}{{ end }}

                    <div class="doc-entry-stats debug">
                        <div class="doc-entry-stat-id debug">{{.DocID}}</div>
                        <div class="doc-entry-stat-date debug">{{ .Date }}</div>
                    </div>
                </div>

                <div class="doc-entry-button debug">
                    <div class="doc-entry-button-del">
                        <button hx-post="/tray/doc-delete" hx-vals='{"id":{{.DocID}}}' hx-target="closest .doc-entry" hx-swap="outerHTML focus-scroll:true" hx-sync="#tray-container:drop" hx-disabled-elt="this">🗑️</button>
                    </div>
                    <div class="doc-entry-button-fav {{ if .Starred }}starred{{end}}">
                        <button hx-post="/tray/doc-star" hx-vals='{"id":{{.DocID}}}' hx-target="closest .doc-entry-button-fav" hx-swap="outerHTML">🌟</button>
                    </div>
                </div>

            </div>
        </li>

    {{ end }}
{{ end }}

{{ define "base/doc-removed.tmpl" }}
    <li class="doc-entry doc-type-removed">
        <i>Removed</i>
        <button class="doc-entry-undo" type="button" aria-label="Restore message {{ .DocID }}"
            hx-post="/tray/doc-restore" hx-vals='{"id":{{ .DocID }},"deleted_at":"{{ .DeletedAt.Format "2006-01-02T15:04:05.999999999Z07:00" }}"}'
            hx-target="closest .doc-entry" hx-swap="outerHTML" hx-sync="#tray-container:drop" hx-disabled-elt="this">Undo</button>
        <span class="doc-entry-undo-status" role="status" aria-live="polite" hidden></span>
    </li>
{{ end }}

{{ define "base/doc-tagbar-segments.tmpl" }}

    <div class="doc-entry-tagview-segment tooltip {{ if .Enabled }}{{ else }}colorfill-greyout{{ end }}"
        hx-post="/tray/post-tag" hx-vals='{"id":{{ .BackRef.DocID }}, "tag":"{{ .Tag.ID}}"}'
        hx-target="closest .doc-entry-tagview-segment" hx-swap="outerHTML"
        style="background-color:{{ if .Enabled }}{{ .Tag.Color }}{{ else }}_{{ end }}">
        {{ .Tag.Sym }}
    <div class="tooltiptext">{{ .Tag.Name }}</div></div>
{{ end }}


{{ define "base/doc-webpreview.tmpl" }}
    {{ range $preview := . }}
        <a href="{{ $preview.URL }}" target="_blank" class="webpreview">
        <div class="doc-entry-web-preview debug">
            <div class="doc-entry-web-preview-image">
                <img src="{{ $preview.Image }}" width="100" height="80"{{ if $preview.ImageFallback }} data-fallback-image="{{ $preview.ImageFallback }}" onerror="this.onerror=null;this.src=this.dataset.fallbackImage"{{ end }}>
            </div>
            <div class="doc-entry-web-preview-text">
                <div class="doc-entry-web-preview-title">
                    {{ $preview.Title }}
                </div>
                <div class="doc-entry-web-preview-description">
                    {{ $preview.Description }}
                </div>
                <div class="doc-entry-web-preview-url">
                    {{ $preview.URL }}
                </div>
            </div>
        </div>
        </a>
    {{ end }}
{{ end }}

{{ define "base/doc-webpreviews.tmpl" }}
    <div id="doc-webpreviews-{{ .DocID }}"{{ if .HasPendingPreviews }} hx-get="/tray/doc-preview/{{ .DocID }}" hx-trigger="every 1s" hx-swap="outerHTML"{{ end }}>
        {{ template "base/doc-webpreview.tmpl" .Webpreview }}
    </div>
{{ end }}

{{ define "base/doc-url.tmpl" }}

	<div class="doc-entry-files-container debug">
		<div class="doc-entry-files debug">

		{{ range $file := . }}
			<a href="{{ $file.Url }}" target="_blank" class="doc-entry-file-download">
			<div class="doc-entry-file-container debug">
				{{ if $file.ThumbnailURL }}
					<div class="doc-entry-file-thumbnail">
						<img src="{{ $file.ThumbnailURL }}" alt="{{ $file.OrgName }}" width="140" height="52" loading="lazy" decoding="async" onerror="this.hidden=true;this.nextElementSibling.hidden=false">
						<span class="material-symbols-outlined" hidden>{{ $file.Icon }}</span>
					</div>
				{{ else }}
					<span class="material-symbols-outlined">{{ $file.Icon }}</span>
				{{ end }}
					<div class="doc-entry-file-name"><span>{{ $file.OrgName }}</span></div>
			</div></a>
		{{end}}

		</div>
	</div>
{{ end }}
